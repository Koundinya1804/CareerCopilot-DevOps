# ─────────────────────────────────────────────────────────────────────────
# CareerCopilot AI — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# Fields with no default in app/core/config.py (SECRET_KEY, MYSQL_PASSWORD)
# are REQUIRED — the app will not start without them.
# ─────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=CareerCopilot AI
APP_VERSION=1.0.0
APP_ENV=development
# development | staging | production — controls /docs exposure, reload, workers
DEBUG=True
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ── Security ─────────────────────────────────────────────────────────────
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Min 32 characters. Rotating this invalidates every issued JWT.
SECRET_KEY=CHANGE_ME_generate_a_real_random_32plus_char_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MySQL ────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=careercopilot
# REQUIRED — no default.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=careercopilot
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800
# Only used by docker-compose.yml, not read by the app itself
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── AWS / S3 (optional — leave blank to skip) ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=careercopilot-files
# Set to a MinIO endpoint (e.g. http://minio:9000) to use S3-compatible
# storage instead of real AWS; leave unset for real S3.
S3_ENDPOINT_URL=

# ── LLM Providers ────────────────────────────────────────────────────────
# Groq is the default and only provider this deployment actually exercises
# end-to-end. At minimum, set GROQ_API_KEY — the app degrades to mock
# responses (not a crash) if no provider key is configured, but real
# answers require a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback providers — optional, only needed if you change DEFAULT_LLM_PROVIDER
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# ── Email (optional — leave blank to skip; password reset emails will log instead of send) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAIL_FROM=CareerCopilot AI <noreply@careercopilot.ai>

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated. Must include your actual frontend origin(s) in production
# — the default only allows local dev ports.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AGENT_PER_MINUTE=10

# ── RAG Pipeline ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_PREFIX=careercopilot
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.30
MAX_CONTEXT_TOKENS=6000
KNOWLEDGE_BASE_DIR=./app/rag/knowledge_base

# ── Resume Analyzer ──────────────────────────────────────────────────────
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
