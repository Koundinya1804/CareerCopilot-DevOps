# =============================================================================
#  CareerCopilot AI — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME="CareerCopilot AI"
APP_VERSION="1.0.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
LOG_LEVEL="DEBUG"              # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Server ---
HOST="0.0.0.0"
PORT=8000
WORKERS=1                      # Increase to CPU count in production

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_USE_OPENSSL_RAND_HEX_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MySQL ---
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="careercopilot"
MYSQL_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
MYSQL_DATABASE="careercopilot"
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800        # Recycle connections every 30 min

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# --- AWS S3 / MinIO ---
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="careercopilot-files"
S3_ENDPOINT_URL=""             # Set for MinIO: http://localhost:9000

# =============================================================================
# LLM Providers
# Set DEFAULT_LLM_PROVIDER to the provider you want to use.
# Only the API key for the selected provider is required.
# All other providers are optional fallbacks.
# =============================================================================

# --- DEFAULT: Groq (llama-3.3-70b-versatile) ---
# Get your free API key at: https://console.groq.com
GROQ_API_KEY="gsk_CHANGE_ME"
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Fallback: Google Gemini ---
GEMINI_API_KEY="AIza-CHANGE_ME"
GEMINI_MODEL="gemini-2.0-flash"

# --- Fallback: Anthropic Claude ---
ANTHROPIC_API_KEY="sk-ant-CHANGE_ME"

# --- Fallback: OpenAI ---
OPENAI_API_KEY="sk-CHANGE_ME"

# --- Active provider selection ---
# Supported values: groq | gemini | anthropic | openai
DEFAULT_LLM_PROVIDER="groq"
DEFAULT_LLM_MODEL="llama-3.3-70b-versatile"

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="CHANGE_ME@gmail.com"
SMTP_PASSWORD="CHANGE_ME"
SMTP_TLS=true
EMAIL_FROM="CareerCopilot AI <noreply@careercopilot.ai>"

# --- CORS ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_HEADERS="*"

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AGENT_PER_MINUTE=10

# --- Resume Analyzer ---
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# --- RAG Pipeline ---
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_PREFIX="careercopilot"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.30
MAX_CONTEXT_TOKENS=6000
KNOWLEDGE_BASE_DIR="./app/rag/knowledge_base"
